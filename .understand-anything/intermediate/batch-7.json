    {
      "id": "file:CNN/nnom-master/scripts/fully_connected_opt_weight_generation.py",
      "type": "file",
      "name": "fully_connected_opt_weight_generation.py",
      "filePath": "CNN/nnom-master/scripts/fully_connected_opt_weight_generation.py",
      "summary": "全连接层的权重转换辅助工具，可将普通的神经网络权重转换成ARM CMSIS-NN库支持 of x4 q7或x4 q15等内存对齐与优化重排格式。",
      "tags": ["工具函数", "权重转换", "cmsis-nn", "全连接", "python"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/scripts/fully_connected_opt_weight_generation.py:convert_to_x4_q7_weights",
      "type": "function",
      "name": "convert_to_x4_q7_weights",
      "summary": "将全连接层权重重新排列为CMSIS-NN优化过的x4 q7目标矩阵格式，实现每4行/列的数据重排。",
      "tags": ["权重转换", "优化", "cmsis-nn"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/fully_connected_opt_weight_generation.py:convert_to_x4_q15_weights",
      "type": "function",
      "name": "convert_to_x4_q15_weights",
      "summary": "将全连接层权重重新排列为CMSIS-NN优化过的x4 q15目标矩阵格式，实现每4行与2列的数据重排。",
      "tags": ["权重转换", "优化", "cmsis-nn"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/fully_connected_opt_weight_generation.py:convert_q7_q15_weights",
      "type": "function",
      "name": "convert_q7_q15_weights",
      "summary": "将权重转换为混合q7-q15精度的特定重排排列结构，以供高效推理计算使用。",
      "tags": ["权重转换", "优化", "cmsis-nn"]
    },
    {
      "id": "file:CNN/nnom-master/scripts/gen_config.py",
      "type": "file",
      "name": "gen_config.py",
      "filePath": "CNN/nnom-master/scripts/gen_config.py",
      "summary": "NNoM框架配置生成器，包含各种将Keras网络层参数转换为微控制器上运行的C语言结构体与张量描述的生成函数。",
      "tags": ["配置生成", "代码生成", "keras解析", "nnom", "python"],
      "complexity": "complex"
    },
    {
      "id": "function:CNN/nnom-master/scripts/gen_config.py:gen_tensor",
      "type": "function",
      "name": "gen_tensor",
      "summary": "生成代表张量（Tensor）的C语言结构体和维度、十进制移位数（Q格式参数）定义。",
      "tags": ["代码生成", "张量定义"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/gen_config.py:gen_conv2d_config",
      "type": "function",
      "name": "gen_conv2d_config",
      "summary": "生成Conv2D卷积层的C语言配置结构体，包含步长、填充类型、卷积核大小以及权重/偏置张量指针等。",
      "tags": ["代码生成", "卷积层", "参数配置"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/gen_config.py:gen_dense_config",
      "type": "function",
      "name": "gen_dense_config",
      "summary": "生成全连接Dense层的C语言配置结构体，包含对应的权重与偏置信息以及输出/偏置的比特偏移量。",
      "tags": ["代码生成", "全连接层", "参数配置"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/gen_config.py:gen_simple_cell_config",
      "type": "function",
      "name": "gen_simple_cell_config",
      "summary": "生成RNN简单单元（Simple RNN Cell）的C语言对应参数，包含权重、循环权重、偏置及对应激活函数和Q格式参数。",
      "tags": ["代码生成", "循环神经网络", "参数配置"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/gen_config.py:gen_lstm_cell_config",
      "type": "function",
      "name": "gen_lstm_cell_config",
      "summary": "生成LSTM单元的C语言参数结构，定义权重、偏置以及各种Q格式移位大小。",
      "tags": ["代码生成", "lstm", "参数配置"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/gen_config.py:gen_gru_cell_config",
      "type": "function",
      "name": "gen_gru_cell_config",
      "summary": "生成GRU单元的C语言参数结构定义，包含隐藏神经元数量、门控参数和权重信息。",
      "tags": ["代码生成", "gru", "参数配置"]
    },
    {
      "id": "file:CNN/nnom-master/scripts/nnom.py",
      "type": "file",
      "name": "nnom.py",
      "filePath": "CNN/nnom-master/scripts/nnom.py",
      "summary": "NNoM框架的核心Python管理脚本，实现BN折叠、各种Keras层权重及输出的定点量化（max-min和KLD方法）、C语言模型及权重文件导出。",
      "tags": ["模型量化", "代码生成", "神经网络", "嵌入式人工智能", "python"],
      "complexity": "complex"
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom.py:fuse_bn_to_conv",
      "type": "function",
      "name": "fuse_bn_to_conv",
      "summary": "将批归一化（BN）层合并折叠到卷积层中，计算合并后的新权重 and 偏置值，以减少嵌入式端推理计算开销。",
      "tags": ["bn折叠", "优化", "神经网络"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom.py:find_dec_bits_kld",
      "type": "function",
      "name": "find_dec_bits_kld",
      "summary": "使用KLD（相对熵）散度校准方法在模型特征图输出的定点量化过程中计算最优的小数位数（Q格式小数位数）。",
      "tags": ["kld校准", "量化"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom.py:quantize_output",
      "type": "function",
      "name": "quantize_output",
      "summary": "对模型各层在验证集下的中间特征图和输出进行整体量化校准，计算网络中所有张量的小数位数。",
      "tags": ["量化", "量化校准"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom.py:quantize_weights",
      "type": "function",
      "name": "quantize_weights",
      "summary": "将Keras浮点权重张量进行8位整数量化，支持逐通道（Per-channel）量化模式，并格式化输出为C风格数组文本。",
      "tags": ["权重量化", "张量定义"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom.py:generate_model",
      "type": "function",
      "name": "generate_model",
      "summary": "将Keras模型结构及其量化权重、参数整体导出生成为目标微控制器可使用的C头文件 weights.h，构成完整的转换入口。",
      "tags": ["代码生成", "模型导出", "转换流水线"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom.py:evaluate_model",
      "type": "function",
      "name": "evaluate_model",
      "summary": "评估量化后的模型表现，输出量化前后模型的预测差异、耗时统计，并将对比报告保存为评估文本。",
      "tags": ["评估", "模型分析"]
    },
    {
      "id": "file:CNN/nnom-master/scripts/nnom_utils.py",
      "type": "file",
      "name": "nnom_utils.py",
      "filePath": "CNN/nnom-master/scripts/nnom_utils.py",
      "summary": "NNoM框架的工具函数模块，包含数据量化范围分析、C头文件结构生成、量化差异评估以及测试二进制文件导出等便捷API。",
      "tags": ["模型量化", "工具函数", "代码生成", "nnom", "python"],
      "complexity": "complex"
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom_utils.py:fuse_bn_to_conv",
      "type": "function",
      "name": "fuse_bn_to_conv",
      "summary": "支持将Batch Normalization层参数前向折叠入Conv或Dense层中。",
      "tags": ["bn折叠", "优化"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom_utils.py:generate_weights",
      "type": "function",
      "name": "generate_weights",
      "summary": "量化模型权重和偏置参数，并转换为嵌入式C数组格式写入目标头文件，支持全连接层权重特有的CMSIS重排。",
      "tags": ["权重量化", "代码生成"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom_utils.py:layers_output_ranges",
      "type": "function",
      "name": "layers_output_ranges",
      "summary": "执行前向推理来校准和统计各个网络层的特征图输出数值范围，决定最优量化定点阶数。",
      "tags": ["范围校准", "量化"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom_utils.py:generate_model",
      "type": "function",
      "name": "generate_model",
      "summary": "解析模型并为NNoM生成最终的C代码网络配置与权重的头文件，作为部署的快捷脚本。",
      "tags": ["代码生成", "模型导出"]
    },
    {
      "id": "function:CNN/nnom-master/scripts/nnom_utils.py:evaluate_model",
      "type": "function",
      "name": "evaluate_model",
      "summary": "对比量化模型与原版浮点模型在测试集上的预测精确度，计算误差概率和运行性能。",
      "tags": ["评估", "模型分析"]
    }
