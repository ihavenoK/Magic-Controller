{
  "nodes": [
    {
      "id": "file:CNN/nnom-master/examples/keyword_spotting/kws_weights.h",
      "type": "file",
      "name": "kws_weights.h",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/kws_weights.h",
      "summary": "包含自动生成的神经网络模型权重和偏置参数，用于基于 NNoM 的关键字识别（KWS）应用。",
      "tags": ["模型权重", "神经网络", "量化参数", "自动生成"],
      "complexity": "moderate"
    },
    {
      "id": "file:CNN/nnom-master/examples/keyword_spotting/main.c",
      "type": "file",
      "name": "main.c",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main.c",
      "summary": "基于 RT-Thread 实时操作系统 and STM32 硬件平台的关键字识别（KWS）应用主入口，实现实时音频采集与模型推理。",
      "tags": ["入口点", "音频处理", "嵌入式系统", "实时推理"],
      "complexity": "complex",
      "languageNotes": "结合了 STM32 HAL 库的 DMA/DFSDM 外设驱动配置与 RT-Thread 事件多线程同步机制，在 C 语言中调用 NNoM 模型。"
    },
    {
      "id": "file:CNN/nnom-master/examples/keyword_spotting/main_pc.c",
      "type": "file",
      "name": "main_pc.c",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main_pc.c",
      "summary": "用于 PC 端的关键字识别性能测试程序，读取测试集音频文件并对比真实标签，计算并评估 NNoM 模型的推理准确率。",
      "tags": ["测试入口", "性能评估", "模型推理", "仿真运行"],
      "complexity": "complex",
      "languageNotes": "采用标准 C 语言文件 I/O 函数（fopen、fscanf）进行批量测试数据的读取与精度评估。"
    },
    {
      "id": "file:CNN/nnom-master/examples/keyword_spotting/mfcc.c",
      "type": "file",
      "name": "mfcc.c",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/mfcc.c",
      "summary": "Mel 频率倒谱系数（MFCC）特征提取的具体实现，包括 Hanning 加窗、FFT 变换、Mel 滤波器组运算和 DCT 特征转换。",
      "tags": ["特征提取", "数字信号处理", "快速傅里叶变换", "算法实现"],
      "complexity": "complex",
      "languageNotes": "支持通过 CMSIS-DSP 库（PLATFORM_ARM）启用硬件加速 FFT，或在无硬件加速时回退至本地软件 FFT 实现。"
    },
    {
      "id": "file:CNN/nnom-master/examples/keyword_spotting/mfcc.h",
      "type": "file",
      "name": "mfcc.h",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/mfcc.h",
      "summary": "定义了 MFCC 提取器状态结构体（mfcc_t）以及 Mel 频率尺度与线性频率相互转换的内联函数，并声明了 MFCC 相关的 API。",
      "tags": ["类型定义", "接口定义", "头文件", "数字信号处理"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/main.c:main",
      "type": "function",
      "name": "main",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main.c",
      "summary": "程序的入口点，初始化同步互斥锁、系统事件，创建 NNoM 模型，并启动关键字识别服务线程与麦克风音频采集。",
      "tags": ["入口点", "初始化", "多线程启动"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/main.c:thread_kws_serv",
      "type": "function",
      "name": "thread_kws_serv",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main.c",
      "summary": "关键字识别的后台线程，等待 DMA 音频数据满事件，提取并量化 MFCC 特征存入环形缓冲区，供主推理循环使用。",
      "tags": ["后台任务", "特征提取", "量化处理"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/main.c:DFSDM_Init",
      "type": "function",
      "name": "DFSDM_Init",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main.c",
      "summary": "初始化 STM32 的多功能数字滤波器（DFSDM），配置音频过采样率、触发源和 DMA 连续转换模式。",
      "tags": ["外设配置", "数字滤波器", "音频采集"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/main.c:HAL_DFSDM_ChannelMspInit",
      "type": "function",
      "name": "HAL_DFSDM_ChannelMspInit",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main.c",
      "summary": "配置 DFSDM 关联的 GPIOE 端口及时钟源，通过 SAI1 的 PLL 锁相环产生高精度的音频主时钟。",
      "tags": ["底层驱动", "引脚配置", "时钟树配置"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/main.c:HAL_DFSDM_FilterMspInit",
      "type": "function",
      "name": "HAL_DFSDM_FilterMspInit",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main.c",
      "summary": "初始化 DFSDM 滤波器的硬件层（MSP），关联 DMA 通道 4，启用循环数据传输模式并设置中断优先级。",
      "tags": ["底层驱动", "DMA初始化", "中断配置"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/main_pc.c:main",
      "type": "function",
      "name": "main",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main_pc.c",
      "summary": "PC 端的仿真入口函数，从文件加载音频特征和地面真值，分帧送入 KWS 服务程序，执行模型推理并输出预测准确率。",
      "tags": ["仿真运行", "文件处理", "准确率测试"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/main_pc.c:thread_kws_serv",
      "type": "function",
      "name": "thread_kws_serv",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/main_pc.c",
      "summary": "仿真环境下的 MFCC 服务模块，调用 mfcc_compute 计算当前帧的 MFCC 特征值并对其量化。",
      "tags": ["特征提取", "信号量化", "测试套件"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/mfcc.c:mfcc_create",
      "type": "function",
      "name": "mfcc_create",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/mfcc.c",
      "summary": "分配并初始化 MFCC 配置上下文，计算填充帧长，初始化 Hanning 窗、Mel 频带滤波器组以及离散余弦变换（DCT）系数矩阵。",
      "tags": ["上下文初始化", "滤波器初始化", "内存申请"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/mfcc.c:mfcc_delete",
      "type": "function",
      "name": "mfcc_delete",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/mfcc.c",
      "summary": "释放 MFCC 上下文中动态申请的所有特征数组、滤波器组和 DCT 系数矩阵，最后释放实例本身的内存。",
      "tags": ["析构释放", "内存清理"],
      "complexity": "simple"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/mfcc.c:create_mel_fbank",
      "type": "function",
      "name": "create_mel_fbank",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/mfcc.c",
      "summary": "在 Mel 音高刻度上生成等间距的三角形带通滤波器组，用于模拟人耳的听觉感知特性。",
      "tags": ["滤波器生成", "听觉心理学", "Mel频率刻度"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/mfcc.c:create_dct_matrix",
      "type": "function",
      "name": "create_dct_matrix",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/mfcc.c",
      "summary": "计算生成用于将 Mel 滤波器组能量转换为倒谱系数的 DCT 正交基矩阵。",
      "tags": ["倒谱分析", "正交矩阵", "离散余弦变换"],
      "complexity": "simple"
    },
    {
      "id": "function:CNN/nnom-master/examples/keyword_spotting/mfcc.c:mfcc_compute",
      "type": "function",
      "name": "mfcc_compute",
      "filePath": "CNN/nnom-master/examples/keyword_spotting/mfcc.c",
      "summary": "执行完整的 MFCC 计算管线，包括预加重、加窗、快速傅里叶变换（FFT）、功率谱计算、Mel 滤波和 DCT 投影。",
      "tags": ["信号转换", "傅里叶变换", "倒谱提取", "核心计算"],
      "complexity": "complex"
    }
