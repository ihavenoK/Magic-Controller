{
  "nodes": [
    {
      "id": "file:CNN/nnom-master/examples/rnn-denoise/denoise_weights.h",
      "type": "file",
      "name": "denoise_weights.h",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/denoise_weights.h",
      "summary": "包含循环神经网络（RNN）去噪模型的权重、偏置以及定点数格式定义。",
      "tags": ["config", "data-model", "type-definition"],
      "complexity": "complex"
    },
    {
      "id": "file:CNN/nnom-master/examples/rnn-denoise/equalizer_coeff.h",
      "type": "file",
      "name": "equalizer_coeff.h",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/equalizer_coeff.h",
      "summary": "定义音频均衡器滤波器的阶数、通道数以及各滤波器的浮点系数（A和B参数）。",
      "tags": ["config", "type-definition"],
      "complexity": "simple"
    },
    {
      "id": "file:CNN/nnom-master/examples/rnn-denoise/main.c",
      "type": "file",
      "name": "main.c",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main.c",
      "summary": "在普通PC平台运行的去噪示例主程序。通过读取WAV音频输入，使用MFCC提取倒谱特征，调用神经网络模型计算每个频带的预测增益，并通过带通滤波器均衡器实时滤波输出去噪后的音频。",
      "tags": ["entry-point", "utility"],
      "complexity": "complex"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main.c:equalizer",
      "type": "function",
      "name": "equalizer",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main.c",
      "summary": "通过多个频带的带通IIR滤波器对信号进行实时滤波，以恢复和增强目标信号。",
      "tags": ["utility", "signal-processing"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main.c:main",
      "type": "function",
      "name": "main",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main.c",
      "summary": "实现PC端降噪流程 of 入口函数，包括加载模型与权重、读取WAV文件帧、提取MFCC特征与量化、模型推理、平滑增益参数并实施频带均衡滤波与文件写回。",
      "tags": ["entry-point", "api-handler"],
      "complexity": "complex"
    },
    {
      "id": "file:CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "type": "file",
      "name": "main_arm.c",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "summary": "在STM32等ARM嵌入式平台运行的实时降噪示例主程序。配合DFSDM外设及DMA中断，实现音频的实时录制、MFCC特征分析、NNoM神经网络降噪推断和IIR均衡器滤波。",
      "tags": ["entry-point", "utility"],
      "complexity": "complex"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main_arm.c:equalizer",
      "type": "function",
      "name": "equalizer",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "summary": "通过多个频带的带通IIR滤波器对ARM平台的实时输入音频帧进行滤波去噪。",
      "tags": ["utility", "signal-processing"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main_arm.c:main",
      "type": "function",
      "name": "main",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "summary": "ARM嵌入式端主循环。初始化音频硬件并以DMA双缓冲模式进行采集；当收到新数据块时，提取MFCC特征并调用NNoM神经网络，通过预测的频带增益动态过滤音频帧并利用LED显示语音检测状态。",
      "tags": ["entry-point", "api-handler"],
      "complexity": "complex"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main_arm.c:LED_Init",
      "type": "function",
      "name": "LED_Init",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "summary": "初始化STM32控制板载LED的GPIO端口 PE8，提供硬件指示灯支持。",
      "tags": ["utility", "hardware-setup"],
      "complexity": "simple"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main_arm.c:us_timer_enable",
      "type": "function",
      "name": "us_timer_enable",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "summary": "初始化并启动微秒级别的基本定时器（TIM2），以进行代码执行时间评测。",
      "tags": ["utility", "hardware-setup"],
      "complexity": "simple"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main_arm.c:DFSDM_Init",
      "type": "function",
      "name": "DFSDM_Init",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "summary": "配置STM32的DFSDM数字滤波器，设置超采样率，将PDM麦克风输入转换并降采样为16kHz、16位的PCM音频流。",
      "tags": ["utility", "hardware-setup"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main_arm.c:HAL_DFSDM_ChannelMspInit",
      "type": "function",
      "name": "HAL_DFSDM_ChannelMspInit",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "summary": "初始化DFSDM外设通道所对应的GPIO引脚PE9、PE7，并配置内部SAI时钟源生成24.57MHz主时钟。",
      "tags": ["utility", "hardware-setup"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/main_arm.c:HAL_DFSDM_FilterMspInit",
      "type": "function",
      "name": "HAL_DFSDM_FilterMspInit",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/main_arm.c",
      "summary": "为DFSDM过滤器配置DMA1_Channel4传输模式，以便在后台自动把采集结果搬运到RAM缓冲区中。",
      "tags": ["utility", "hardware-setup"],
      "complexity": "moderate"
    },
    {
      "id": "file:CNN/nnom-master/examples/rnn-denoise/mfcc.c",
      "type": "file",
      "name": "mfcc.c",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/mfcc.c",
      "summary": "提供MFCC特征提取的数学计算函数，包括预加重、加窗、FFT运算、Mel滤波器组映射及DCT矩阵变换等功能。",
      "tags": ["utility", "signal-processing"],
      "complexity": "complex"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/mfcc.c:mfcc_create",
      "type": "function",
      "name": "mfcc_create",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/mfcc.c",
      "summary": "分配并初始化MFCC处理器结构体，创建相应的汉明窗数组、Mel滤波器组参数矩阵及DCT转换矩阵。",
      "tags": ["utility", "signal-processing"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/mfcc.c:mfcc_delete",
      "type": "function",
      "name": "mfcc_delete",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/mfcc.c",
      "summary": "销毁MFCC处理器结构体，并释放相关的动态分配缓冲和矩阵内存。",
      "tags": ["utility", "signal-processing"],
      "complexity": "simple"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/mfcc.c:create_dct_matrix",
      "type": "function",
      "name": "create_dct_matrix",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/mfcc.c",
      "summary": "基于余弦基函数计算并创建一维离散余弦变换（DCT-II）系数矩阵。",
      "tags": ["utility", "signal-processing"],
      "complexity": "simple"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/mfcc.c:create_mel_fbank",
      "type": "function",
      "name": "create_mel_fbank",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/mfcc.c",
      "summary": "在Mel频率轴上等距划分频带，计算每个滤波器在FFT频点上的权重大小，从而生成Mel三角滤波器组。",
      "tags": ["utility", "signal-processing"],
      "complexity": "moderate"
    },
    {
      "id": "function:CNN/nnom-master/examples/rnn-denoise/mfcc.c:mfcc_compute",
      "type": "function",
      "name": "mfcc_compute",
      "filePath": "CNN/nnom-master/examples/rnn-denoise/mfcc.c",
      "summary": "计算输入PCM音频帧的MFCC特征。流程包括：预加重、加汉明窗、RFFT傅里叶变换、频带能量Mel滤波器积分、对数幅度计算、DCT变换及差分与能量项追加。",
      "tags": ["utility", "signal-processing"],
      "complexity": "complex"
    },
    {
